{
  "configVersion": "v3",
  "app": {
    "appId": 1088813,
    "appName": "Xeque Cards",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "Xeque News",
    "description": "Flashcards do dia no pulso: quiz e glossários do Xeque-Mate, do Observatório e do Terra Brasilis."
  },
  "permissions": [
    "data:os.device.info",
    "device:os.local_storage"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "3.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "common": {
      "module": {
        "page": {
          "pages": [
            "page/index",
            "page/carta"
          ]
        },
        "app-side": {
          "path": "app-side/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        },
        {
          "st": "r",
          "dw": 466
        },
        {
          "st": "s",
          "dw": 390
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "Xeque Cards"
    },
    "pt-BR": {
      "appName": "Xeque Cards"
    }
  },
  "defaultLanguage": "en-US"
}